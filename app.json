{
  "expo": {
    "name": "HorizonSync",
    "slug": "bwmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A73E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.horizonsync.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is needed to scan QR codes for inventory management."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8"
      },
      "package": "com.horizonsync.mobile",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "blockedPermissions": []
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is needed to scan QR codes for inventory management."
        }
      ],
      [
        "expo-secure-store"
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aef71333-23d4-4700-9d1c-9beb362b1aee"
      }
    }
  }
}
